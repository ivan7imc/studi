# Copie para .env e preencha. O arquivo .env não é versionado.
# No Render, configure estas variáveis em Environment (não use .env).

# Connection string do Neon — Dashboard do projeto > Connect > "Pooled connection".
# Mantenha o ?sslmode=require no final.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Porta do servidor HTTP (o Render injeta PORT automaticamente).
PORT=3000

# Máximo de conexões no pool. Com connection string "pooled" do Neon, 5 é suficiente.
PGPOOL_MAX=5

# Defina como true para ignorar o banco e gravar em data/progress.local.json.
# SKIP_DATABASE=true

# Opcional: protege o site com usuário e senha (o navegador pede ao abrir).
# Recomendado no Render, já que a URL do serviço é pública.
# BASIC_AUTH_USER=estudos
# BASIC_AUTH_PASSWORD=troque-por-uma-senha-forte
